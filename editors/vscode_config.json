{
  // Window and workbench
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "never",
  // "window.titleBarStyle": "native",
  "window.title": "${activeEditorMedium}${separator}${rootName}${separator}${profileName}${separator}${activeRepositoryBranchName}${separator}${dirty}",
  "window.zoomLevel": -1,
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.statusBar.visible": false,
  "workbench.iconTheme": null,
  "workbench.tree.enableStickyScroll": false,
  "workbench.list.smoothScrolling": true,
  "breadcrumbs.enabled": false,
  "explorer.decorations.badges": false,

  // Editor typography and spacing
  "editor.fontFamily": "SF Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.1,
  "editor.padding.top": 12,
  "editor.padding.bottom": 12,

  // Editor layout and scrolling
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "off",
  "editor.lineNumbersMinChars": 0,
  "editor.lineDecorationsWidth": 0,
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.stickyScroll.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollBeyondLastLine": false,
  "editor.scrollBeyondLastColumn": 0,
  "editor.smoothScrolling": true,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.largeFileOptimizations": false,

  // Cursor, highlights, and guides
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "editor.renderLineHighlight": "none",
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.matchBrackets": "never",
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",

  // Formatting and language settings
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  // "editor.formatOnPaste": true,
  "css.lint.unknownAtRules": "ignore",
  "go.toolsManagement.autoUpdate": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // Git, diffs, and debugging
  "git.autofetch": true,
  "git.confirmSync": false,
  // "git.blame.editorDecoration.enabled": true,
  "scm.diffDecorations": "none",
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "debug.showBreakpointsInOverviewRuler": true,

  // Terminal
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.smoothScrolling": true,

  // Privacy and AI
  "telemetry.telemetryLevel": "off",
  // Hide and disable built-in AI, including chat, completions, and agents.
  "chat.disableAIFeatures": true,

  // Theme colors
  "workbench.colorCustomizations": {
    "[Default Light Modern]": {
      "editor.wordHighlightBackground": "#0000",
      "editor.wordHighlightBorder": "#0080ff",
      "editor.wordHighlightStrongBackground": "#0000",
      "editor.wordHighlightStrongBorder": "#0080ff",
      "editorCursor.foreground": "#007bff",
      "editorGroup.border": "#0000",
      "editorWidget.background": "#ffffff",
      "editorWidget.border": "#ffffff",
      "focusBorder": "#0000",
      "list.activeSelectionBackground": "#eeeeee",
      "list.hoverBackground": "#0000",
      "list.inactiveSelectionBackground": "#eeeeee",
      "panel.background": "#ffffff",
      "panel.border": "#0000",
      "scrollbar.shadow": "#0000",
      "scrollbarSlider.activeBackground": "#0000",
      "scrollbarSlider.background": "#0000",
      "scrollbarSlider.hoverBackground": "#0000",
      "sideBar.background": "#ffffff",
      "sideBar.border": "#ffffff",
      "widget.shadow": "#0000"
    },
    "[Default Dark Modern]": {
      "editor.wordHighlightBackground": "#0000",
      "editor.wordHighlightBorder": "#0080ff",
      "editor.wordHighlightStrongBackground": "#0000",
      "editor.wordHighlightStrongBorder": "#0080ff",
      "editorCursor.foreground": "#007bff",
      "editorGroup.border": "#0000",
      "editorWidget.background": "#1f1f1f",
      "editorWidget.border": "#1f1f1f",
      "focusBorder": "#0000",
      "list.activeSelectionBackground": "#303030",
      "list.hoverBackground": "#0000",
      "list.inactiveSelectionBackground": "#282828",
      "panel.background": "#1f1f1f",
      "panel.border": "#0000",
      "scrollbar.shadow": "#0000",
      "scrollbarSlider.activeBackground": "#0000",
      "scrollbarSlider.background": "#0000",
      "scrollbarSlider.hoverBackground": "#0000",
      "sideBar.background": "#1f1f1f",
      "sideBar.border": "#1f1f1f",
      "widget.shadow": "#0000"
    }
  }
}
