# vi: ft=dosini
# ANSI-named colors for pgcli, so it renders in whatever the terminal profile
# defines.
#
# This is the user config pgcli reads by default. `theme ansi` in .zshrc leaves
# PGCLIRC unset, which is what makes pgcli fall back to it. `theme gruvbox` sets
# PGCLIRC to config-gruvbox, and that replaces this file as the user config
# entirely. pgcli merges whichever of the two it reads over its own packaged
# pgclirc, so both files hold only theme keys and every other setting keeps its
# pgcli default. Keeping this one partial is what stops the two paths from
# drifting when pgcli changes its defaults.
#
# pgcli rewrites its user config in place when you save a named query (\ns, \ne),
# and this file is a symlink into the repo, so that shows up as a diff here.
# ConfigObj preserves comments on write, so it only adds a [named queries]
# section.
#
# It writes to whichever file it read, and pgcli has no include mechanism, so a
# query saved under `theme ansi` lands here and is invisible under
# `theme gruvbox`, which reads config-gruvbox. Copy it across by hand if you want
# it in both.
#
# The mapping below needs a profile that keeps ANSI 0 dark and 7/15 light, which
# Terminal.app's default Basic profile does and Ghostty's Gruvbox Material Light
# does not. _theme_ansi refuses to run under Ghostty for that reason. Only light
# profiles are supported, so slot 0 is text and 7/15 are surfaces — the reverse
# of what a dark palette wants.
#   ansiblack (0)        body text        ansigray (7)   popup surface
#   ansiwhite (15)       toolbar surface  ansibrightblack (8) dimmed text
#   ansired  keywords, errors             ansiyellow  types, operators
#   ansigreen strings                     ansiblue    prompt, accent

[main]
# `bw` contributes bold/italic and no color, so no Pygments theme's own hexes
# bleed through to fight the profile; every color below is explicit.
syntax_style = bw

[colors]
# Completion popup. One surface for the whole popup with the meta column merely
# dimmed — splitting body and meta across two greys reads as mud.
#
# WRITTEN INVERTED on purpose: prompt_toolkit's defaults apply `reverse` to
# completion-menu.completion.current (and to `selected` below), so the fg/bg pair
# here is swapped at render time. Cancelling it with `noreverse` is not an option
# — pgcli feeds this same section to Pygments for the result-table style, and
# Pygments rejects `noreverse` as a color, which crashes pgcli on startup. So the
# line below reads "blue text on slot 15" and renders as slot 15 text on a blue
# bar. Only these two classes are affected; nothing else here carries `reverse`.
completion-menu = 'bg:ansigray ansiblack'
completion-menu.completion = 'bg:ansigray ansiblack'
completion-menu.completion.current = 'ansiblue bg:ansiwhite bold'
completion-menu.meta.completion = 'bg:ansigray ansibrightblack'
completion-menu.meta.completion.current = 'bg:ansiblue ansiwhite'
completion-menu.multi-column-meta = 'bg:ansigray ansibrightblack'

# The popup's vertical scrollbar comes from prompt_toolkit's margin, which reads
# scrollbar.background/.button — NOT pgcli's `scrollbar`/`scrollbar.arrow` keys
# (those only cover the </> arrows in multi-column mode). Without these two the
# bar keeps prompt_toolkit's stock #aaaaaa/#444444 and shows up as a grey-charcoal
# block that ignores the theme entirely.
scrollbar.background = 'bg:ansigray'
scrollbar.button = 'bg:ansibrightblack'
scrollbar = 'bg:ansigray ansiblack'
scrollbar.arrow = 'noinherit bold bg:ansigray ansiblue'

# Mirror the terminal's own selection, which swaps fg/bg, rather than invent a
# color. Also written inverted, for the `reverse` reason above.
selected = 'ansigray bg:ansiblack'
search = 'bg:ansiyellow ansiblack'
search.current = 'bg:ansigreen ansiblack'

# Slot 15 rather than 7: the toolbar sits against the terminal background all the
# way across, and the popup's greyer surface reads as a slab down there.
bottom-toolbar = 'bg:ansiwhite ansiblack'
bottom-toolbar.off = 'bg:ansiwhite ansibrightblack'
bottom-toolbar.on = 'bg:ansiwhite ansiblack bold'
bottom-toolbar.transaction.valid = 'bg:ansiwhite ansigreen bold'
bottom-toolbar.transaction.failed = 'bg:ansiwhite ansired bold'
search-toolbar = 'noinherit bold'
search-toolbar.text = 'nobold'
system-toolbar = 'noinherit bold'
arg-toolbar = 'noinherit bold'
arg-toolbar.text = 'nobold'

prompt = 'ansiblue bold'
continuation = 'ansibrightblack'

# SQL syntax highlighting for the input buffer. The `literal.string`,
# `literal.number` and `keyword` keys documented by pgcli only reach the output
# token style, not the buffer — the lexer emits `pygments.*` classes, so those
# are the names that actually recolor what you type.
# (pgcli logs one "Unhandled style / class name" line per key below into
# ~/.config/pgcli/log at startup; it only knows these names on the buffer side.)
pygments.keyword = 'ansired bold'
pygments.keyword.type = 'ansiyellow'
pygments.name = 'ansiblack'
pygments.name.builtin = 'ansiyellow'
pygments.name.function = 'ansigreen'
# `noitalic` undoes bw's italic on strings; only comments should be italic.
pygments.literal.string = 'ansigreen noitalic'
pygments.literal.string.name = 'ansicyan noitalic'
pygments.literal.number = 'ansimagenta'
pygments.comment = 'ansibrightblack italic'
pygments.operator = 'ansiyellow'
pygments.punctuation = 'ansibrightblack'
pygments.error = 'ansired bold'

# Result tables. These bypass prompt_toolkit: cli_helpers renders them through a
# Pygments terminal formatter, and when the terminal advertises COLORTERM the
# truecolor one substitutes fixed RGB for ANSI palette names, turning e.g.
# 'ansiblue' into navy. Attribute-only styles keep the table on the terminal's
# own foreground under either formatter.
output.header = "bold underline"
output.odd-row = ""
output.even-row = ""
output.null = "italic"
